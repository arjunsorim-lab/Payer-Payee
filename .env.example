# Local development
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=PayerPayee
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://payer-payee-1.onrender.com
CSV_PATH=/Users/user/Downloads/EDI_834_837_20 members(837_Claims).csv
SAVINGS_WORKBOOK_PATH=data/claims-demo.xlsx
CLAIMS_WORKSHEET_NAME=837_Claims
ELIGIBILITY_WORKSHEET_NAME=834_Eligibility
REASON_LEGEND_WORKSHEET_NAME=Reason_Code_Legend
FIELD_DICTIONARY_WORKSHEET_NAME=New_Fields_Dictionary
DATA_NOTES_WORKSHEET_NAME=Data_Notes_READ_ME
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_CACHE_TTL_SECONDS=900
GROQ_TIMEOUT_SECONDS=15
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=gemma3
OLLAMA_EMBED_MODEL=embeddinggemma
REPEAT_PRIOR_STRENGTH=8
PREDICTION_PRIOR_STRENGTH=8
AVOIDABLE_PRIOR_STRENGTH=8
AVOIDABLE_MIN_HIERARCHY_PEERS=3
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MAX_PREDICT_TOKENS=160
RAG_TOP_K=8
RAG_VECTOR_WEIGHT=0.55
RAG_STRUCTURED_WEIGHT=0.45
RAG_INDEX_DIR=backend/.rag_index
RAG_VERSION=workbook-rag-v1
RAG_EMBED_BATCH_SIZE=64
RAG_AUTO_BUILD=true
ENABLE_RAG_ADMIN=false
REVIEW_SESSION_SECRET=
REVIEW_USERS_JSON={}
REVIEW_DB_PATH=.review-data/reviews.sqlite3
# Set APP_ENV=production (or REQUIRE_AUTH=true) for any remote deployment.
# REVIEW_USERS_JSON values must contain a werkzeug password_hash and a role
# (viewer, reviewer, or admin); never store plaintext passwords. The service
# returns 503 instead of serving claims when authentication is required but
# credentials are missing, and rejects remote requests in local demo mode.
APP_ENV=development
REQUIRE_AUTH=false
# Generate real values with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('change-me'))"

# Bounded in-process caches. Lower these on small instances; raise them only
# with the matching memory headroom.
CACHE_MAX_ENTRIES=512
FINANCIAL_CACHE_MAX_ENTRIES=512
PAYER_MEMBER_CACHE_MAX_ENTRIES=128
LLM_CACHE_MAX_ENTRIES=128
RAG_CACHE_MAX_ENTRIES=8
PROVIDER_EPISODE_WINDOW_DAYS=90
PROVIDER_MIN_PEERS=5
PAYER_COHORT_EPISODE_DAYS=90
PAYER_SCENARIO1_UNIT_TOLERANCE=1

# Render service
RENDER_SERVICE_NAME=payer-payee
RENDER_SERVICE_URL=https://payer-payee-1.onrender.com
PYTHON_VERSION=3.12.8

# Copy these values into Render's Environment tab.
# Do not use mongodb://localhost:27017/ on Render; use MongoDB Atlas or another hosted MongoDB URI.
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/PayerPayee?retryWrites=true&w=majority
# MONGODB_DB=PayerPayee
# CORS_ORIGIN=https://payer-payee-1.onrender.com
# REVIEW_SESSION_SECRET=<at least 32 random characters>
# REVIEW_USERS_JSON={"reviewer":{"password_hash":"<werkzeug hash>","role":"reviewer"}}
